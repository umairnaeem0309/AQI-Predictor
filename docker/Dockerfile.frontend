# =============================================================================
# AQI Predictor - Frontend Dockerfile
# Streamlit dashboard
# =============================================================================

# Stage 1: Build dependencies
FROM python:3.11-slim as builder

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (frontend-specific)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Production image
FROM python:3.11-slim

# Security: Run as non-root user
RUN groupadd -r aqiuser && useradd -r -g aqiuser aqiuser

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /root/.local /home/aqiuser/.local

# Copy application code
COPY app/frontend/ ./app/frontend/
COPY app/__init__.py ./app/__init__.py

# Create .streamlit directory
RUN mkdir -p .streamlit

# Set ownership
RUN chown -R aqiuser:aqiuser /app

# Switch to non-root user
USER aqiuser

# Update PATH
ENV PATH=/home/aqiuser/.local/bin:$PATH

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV MOCK_MODE=false
ENV API_BASE_URL=http://backend:8000

# Expose port
EXPOSE 8501

# Healthcheck using Python
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

# Production command
CMD ["streamlit", "run", "app/frontend/streamlit_app.py", \
     "--server.port=8501", \
     "--server.address=0.0.0.0", \
     "--server.headless=true", \
     "--browser.gatherUsageStats=false"]

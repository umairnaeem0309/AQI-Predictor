# Streamlit Cloud Secrets
# Copy this to .streamlit/secrets.toml and fill in the values
# NEVER commit the actual secrets.toml file

# API_BASE_URL should point to your Render-deployed FastAPI backend
# After deploying to Render, you'll get a URL like: https://aqi-predictor-api.onrender.com
API_BASE_URL = "https://aqi-predictor-api.onrender.com"

# Optional: API key if you configured one
# API_KEY = "your-api-key-here"

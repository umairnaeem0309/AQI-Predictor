# Ensure consistent line endings for all text files
* text=auto eol=lf

# Python files must always use LF
*.py text eol=lf

# Shell scripts must always use LF
*.sh text eol=lf

# YAML files must always use LF
*.yml text eol=lf
*.yaml text eol=lf

# Markdown files
*.md text eol=lf

# JSON files
*.json text eol=lf

# Config files
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Binary files (do not modify)
*.pkl binary
*.parquet binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# =============================================================================
# AQI Predictor — Environment Variables
# =============================================================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control
# =============================================================================

# --- API Keys ---
OPENWEATHER_API_KEY=
AQICN_API_KEY=

# --- Feature Store ---
HOPSWORKS_API_KEY=
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai

# --- MLflow ---
# Leave empty for local file-based tracking (no server required)
# Set to a URL only when using a remote MLflow tracking server
MLFLOW_TRACKING_URI=

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
